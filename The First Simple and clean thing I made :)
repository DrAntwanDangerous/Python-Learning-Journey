        print("I send you my strength, things will get better, rest and think about your soul.")
    elif spirit.lower() =="supercharged":
        print("Ride the lightning! Go get em!!")
    elif spirit.lower() =="Calm":
        print(" It is nice to be at peace, I am happy for you.")
    else:
        print("No matter how your Spirit feels, you are loved and protected.")

    again=input("Would you like to chat again (Yes/No)??")
    
    if again.lower() =="no":
        print(" When you're ready come back and see me.")
        exit()
    else:
        continue
